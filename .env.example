# Copy this file to .env and fill it in.
PORT=3000
# Public address of the site, used in sitemap.xml
SITE_URL=https://www.example.com

# Email delivery for enquiries (optional). Without these, enquiries are
# still saved to data/enquiries.jsonl and files to data/uploads/.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ENQUIRY_FROM=
ENQUIRY_TO=
